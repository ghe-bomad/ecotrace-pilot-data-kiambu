# Derived data is regenerated from data/raw_data/ by src/derive.py.
# Only the README is tracked; the CSVs themselves are never committed.
data/derived_data/*
!data/derived_data/README.md

# Raw household survey export — direct identifiers (GPS, phone numbers, Kobo
# keys). NEVER commit. data/survey.csv is the de-identified file built from it
# by src/prepare_survey.py and IS published.
data/survey_raw*.csv
*_PRIVATE.csv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# OS
.DS_Store
